{
  "name": "foundation-backend",
  "version": "1.0.0",
  "description": "Node.js & PostgreSQL Backend with Prisma ORM and Express",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "db:migrate": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/prisma/build/index.js db push",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "node --env-file-if-exists=.env.local --env-file-if-exists=.env ./node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
