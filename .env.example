# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL Connection String
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Examples:
# Local Postgres: postgresql://postgres:postgres@localhost:5432/foundation_db?schema=public
# Supabase/Neon: postgresql://postgres:[PASSWORD]@[HOST].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foundation_db?schema=public"
# Use the direct PostgreSQL URL for Prisma schema changes.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
